---
import Layout from '../layouts/Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
---
<Layout title="Hyroot – Nastavení nového hesla">
  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0d1f14;
      color: #e0e0e0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card {
      max-width: 420px;
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(82,183,136,0.2);
      border-radius: 24px;
      padding: 40px 32px;
      text-align: center;
    }
    .logo { color: #52b788; font-size: 36px; font-weight: 800; margin-bottom: 4px; }
    .tagline { color: #4a7c59; font-size: 13px; margin-bottom: 32px; }
    .icon { font-size: 48px; margin-bottom: 16px; }
    .title { color: #d8f3dc; font-size: 20px; font-weight: 700; margin-bottom: 8px; }
    .message { color: #95d5b2; font-size: 14px; line-height: 1.6; margin-bottom: 24px; }
    .btn {
      display: inline-block;
      background: #52b788;
      color: #0d1f14;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      padding: 14px 32px;
      border-radius: 14px;
      margin-bottom: 16px;
      transition: opacity 0.2s;
    }
    .btn:hover { opacity: 0.9; }
    .hint { color: #4a7c59; font-size: 12px; line-height: 1.5; margin-top: 16px; }
    .desktop-hint {
      font-size: 15px;
      color: #52b788;
      font-weight: 600;
      margin-bottom: 12px;
      line-height: 1.5;
    }
    .spinner {
      width: 24px; height: 24px;
      border: 3px solid #1a4731;
      border-top-color: #52b788;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 16px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .status { color: #74c69d; font-size: 14px; margin-bottom: 8px; }
    .hidden { display: none; }
    .card-top { display: flex; justify-content: flex-end; margin: -20px -12px 8px; }
  </style>

  <div class="card">
    <div class="card-top"><LangSwitch /></div>
    <img src="/logo.png" alt="Hyroot" style="width: 80px; height: 80px; border-radius: 20px; margin-bottom: 16px;" />
    <div class="logo">Hyroot</div>
    <div class="tagline">Your hydroponic journal</div>

    <!-- Loading state -->
    <div id="loading">
      <div class="spinner"></div>
      <div class="status" id="status-cs" data-lang-content="cs">Přesměrovávám do aplikace...</div>
      <div class="status hidden" id="status-en" data-lang-content="en">Redirecting to the app...</div>
    </div>

    <!-- Success -->
    <div id="result" class="hidden">
      <div class="icon">🔑</div>

      <div id="content-cs" data-lang-content="cs">
        <div class="title">Nastav nové heslo</div>
        <div class="message">
          Odkaz pro reset hesla byl ověřen. Otevři aplikaci Hyroot a zadej nové heslo.
        </div>
        <a href="#" id="open-app-btn-cs" class="btn">Otevřít aplikaci</a>
        <div id="desktop-hint-cs" class="desktop-hint hidden">
          Otevři aplikaci Hyroot na svém telefonu a zadej nové heslo.
        </div>
        <div class="hint">
          Pokud se aplikace neotevřela automaticky, otevři ji ručně na svém telefonu.
        </div>
      </div>

      <div id="content-en" data-lang-content="en" class="hidden">
        <div class="title">Set a new password</div>
        <div class="message">
          Your password reset link has been verified. Open the Hyroot app and enter your new password.
        </div>
        <a href="#" id="open-app-btn-en" class="btn">Open app</a>
        <div id="desktop-hint-en" class="desktop-hint hidden">
          Open the Hyroot app on your phone and enter your new password.
        </div>
        <div class="hint">
          If the app didn't open automatically, open it manually on your phone.
        </div>
      </div>
    </div>

    <!-- Error state -->
    <div id="error" class="hidden">
      <div class="icon">⚠️</div>

      <div id="error-cs" data-lang-content="cs">
        <div class="title">Neplatný odkaz</div>
        <div class="message">
          Odkaz pro reset hesla je neplatný nebo vypršel. Požádej o nový reset hesla v aplikaci.
        </div>
      </div>

      <div id="error-en" data-lang-content="en" class="hidden">
        <div class="title">Invalid link</div>
        <div class="message">
          The password reset link is invalid or has expired. Please request a new password reset in the app.
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function isMobile() {
      return /Android|iPhone|iPad|iPod|Opera Mini|IEMobile|WPDesktop/i.test(navigator.userAgent);
    }

    (function() {
      var hash = window.location.hash;
      var params = new URLSearchParams(hash.replace('#', ''));

      var accessToken = params.get('access_token');
      var refreshToken = params.get('refresh_token');
      var type = params.get('type');

      if (accessToken && type === 'recovery') {
        var deepLink = 'hyroot://auth?access_token=' + encodeURIComponent(accessToken) + '&refresh_token=' + encodeURIComponent(refreshToken || '') + '&type=recovery';

        document.getElementById('open-app-btn-cs').href = deepLink;
        document.getElementById('open-app-btn-en').href = deepLink;

        if (isMobile()) {
          setTimeout(function() { window.location.href = deepLink; }, 500);
        } else {
          document.getElementById('open-app-btn-cs').classList.add('hidden');
          document.getElementById('open-app-btn-en').classList.add('hidden');
          document.getElementById('desktop-hint-cs').classList.remove('hidden');
          document.getElementById('desktop-hint-en').classList.remove('hidden');
        }

        setTimeout(function() {
          document.getElementById('loading').classList.add('hidden');
          document.getElementById('result').classList.remove('hidden');
        }, isMobile() ? 2000 : 500);

      } else {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('error').classList.remove('hidden');
      }
    })();
  </script>
</Layout>
